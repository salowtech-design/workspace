# ==============================================================================
# SALOW WORKSPACE — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your values.
# NEVER commit '.env' to git or share passwords in chat or public channels.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-at-least-50-chars
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- DATABASE CONFIGURATION (TiDB Cloud Starter) ---
# Obtain these values from your TiDB Cloud Console -> Clusters -> Connect
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_cluster_prefix.root
TIDB_PASSWORD=your_secure_tidb_password
TIDB_DB_NAME=salow_workspace

# TLS / CA Certificate path for TiDB Cloud SSL connection.
# On Windows, leave blank to use the standard certifi CA bundle, or provide an absolute path:
# e.g., C:\Users\Dr Arif\Workspace.SalowTech\certs\isrgrootx1.pem
TIDB_CA_PATH=

# --- VERIFIER & FEATURE FLAGS ---
# DEV_VERIFIER allows the development StubVerifier for attendance.
# MUST BE False in production. Production settings will refuse startup if True.
DEV_VERIFIER=True

# --- SECURITY & COOKIES (Production Overrides) ---
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
